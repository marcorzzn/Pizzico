{
  "name": "pizzico",
  "version": "0.1.3",
  "private": true,
  "description": "Pizzico — Laboratorio di Ingegneria del Software Creativo (Root Monorepo)",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @pizzico/app-web dev",
    "build:wasm": "wasm-pack build crates/wasm-bindings --target web --out-dir ../../packages/worker-core/pkg",
    "bump": "node scripts/bump-version.mjs",
    "test": "pnpm -r test",
    "test:wasm": "node tests/wasm-roundtrip.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
