# Pizzico — .gitignore
# Riferimento manifesto: §4
# Licenza: MIT OR Apache-2.0

# Node / pnpm
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
out/
.next/
.turbo/
!tools/patches/**

# Rust / WASM
target/
# Cargo.lock è VERSIONATO di proposito: questo è un workspace applicativo con
# deploy web e APK, non una libreria. Il lockfile garantisce che CI e macchine
# diverse risolvano le stesse versioni (decisione del 2026-10-26).
crates/**/pkg/
packages/**/pkg/
!packages/worker-core/pkg/
*.wasm
!apps/web/public/pizzico_wasm_bindings_bg.wasm
!packages/worker-core/pkg/pizzico_wasm_bindings_bg.wasm

# Tauri
apps/tauri/src-tauri/target/
apps/tauri/gen/

# Testing & Coverage
coverage/
test-results/
playwright-report/
blob-report/

# OS / Editor files
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.antigravity/
*.swp
*.swo

# Legacy isolated folder (preserve README, keep heavy dumps uncommitted)
docs/_legacy/*
!docs/_legacy/README.md

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Public exports & test assets
apps/web/public/exports/
apps/web/public/*.psd

# Progetti da aggregare (audit esterno, mai committare)
progetti da aggregare/

# Archivio personale di analisi — MAI committare (contiene materiale locale)
_archivio-personale/
**/*.apk
**/*.smali
**/jadx_out/
**/apktool_out/
**/dex2jar_out/
