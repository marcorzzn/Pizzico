{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pizzico",
  "version": "0.1.2",
  "identifier": "io.github.marcorzzn.pizzico",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @pizzico/app-web dev",
    "beforeBuildCommand": "pnpm --filter @pizzico/app-web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pizzico — editor grafico",
        "width": 1280,
        "height": 840,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' blob: data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "publisher": "Marco Razzano",
    "copyright": "Copyright © 2026 Marco Razzano",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 1002
    }
  }
}
